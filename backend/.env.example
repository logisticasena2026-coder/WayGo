# ============================================================
# WayGo - Plantilla de variables de entorno
# Copiar a .env y completar los valores reales
# ============================================================
NODE_ENV=development
PORT=4000
APP_NAME=WayGo
APP_TIMEZONE=America/Bogota

# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL=postgresql://waygo:CAMBIAR_PASSWORD@127.0.0.1:5433/waygo_db?schema=public

# JWT - generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CAMBIAR_SECRETO_ACCESS
JWT_REFRESH_SECRET=CAMBIAR_SECRETO_REFRESH
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend (CORS)
CLIENT_URL=http://localhost:5173

# Correo: console (desarrollo, imprime enlaces en consola) | smtp (produccion)
MAIL_PROVIDER=console
MAIL_FROM=no-reply@waygo.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Subida de archivos
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# bcrypt (10-12 recomendado)
BCRYPT_ROUNDS=12
