# ============================================================
# WayGo - Variables para docker-compose.yml (raiz)
# Copiar a .env y completar. Para desarrollo local sin Docker,
# usar backend/.env (ver backend/.env.example)
#
# En Dokploy NO se usa este archivo: las mismas variables se
# cargan en la seccion "Environment" de la aplicacion.
# ============================================================

# ---- Obligatorias (el compose falla si faltan) ----------------
# Contrasena del usuario waygo de PostgreSQL (contenedor)
DB_PASSWORD=cambiar-esta-contrasena

# Secretos JWT - generar con (correr una vez por variable):
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CAMBIAR_SECRETO_ACCESS
JWT_REFRESH_SECRET=CAMBIAR_SECRETO_REFRESH

# URL publica del frontend (para CORS). En produccion debe ser
# el dominio real, ej: https://waygo.tudominio.com
CLIENT_URL=http://localhost:5173

# ---- Seguridad de sesion ---------------------------------------
# true en produccion (HTTPS): la cookie solo viaja por HTTPS.
# false en local sobre http://localhost
COOKIE_SECURE=false

# ---- Usuarios iniciales (prisma/seed.js) -----------------------
# El seed es idempotente: si el usuario ya existe, no lo toca.
SEED_ADMIN_EMAIL=admin@waygo.local
# Dejar vacio genera una contrasena aleatoria que se imprime UNA
# sola vez en los logs del contenedor. En produccion, definirla.
SEED_ADMIN_PASSWORD=
SEED_CALLCENTER_EMAIL=callcenter@waygo.local
SEED_CALLCENTER_PASSWORD=

# ---- Correo -----------------------------------------------------
# console: no envia nada, solo imprime en los logs
# smtp:     envia correos reales (requiere SMTP_* abajo)
MAIL_PROVIDER=console
MAIL_FROM=no-reply@waygo.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Opcionales -------------------------------------------------
# Tamanio maximo de fotos/documentos (MB). El nginx del frontend
# esta configurado con client_max_body_size 10m.
MAX_FILE_SIZE_MB=5

# Zona horaria operativa de la plataforma
APP_TIMEZONE=America/Bogota
