# ============================================================
# WayGo - Variables para docker-compose.yml (raiz)
# Copiar a .env y completar. Para desarrollo local sin Docker,
# usar backend/.env (ver backend/.env.example)
# ============================================================

# Contrasena del usuario waygo de PostgreSQL (contenedor)
DB_PASSWORD=cambiar-esta-contrasena

# Secretos JWT - generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CAMBIAR_SECRETO_ACCESS
JWT_REFRESH_SECRET=CAMBIAR_SECRETO_REFRESH

# URL publica del frontend (para CORS)
CLIENT_URL=http://localhost:5173

# Correo: console | smtp
MAIL_PROVIDER=console
