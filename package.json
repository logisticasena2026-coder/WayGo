{
  "name": "waygo",
  "version": "1.0.0",
  "description": "WayGo - Plataforma inteligente de transporte y servicios (personas, paquetes y contratos mensuales)",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:start": "powershell -File tools/scripts/db-start.ps1",
    "db:stop": "powershell -File tools/scripts/db-stop.ps1",
    "db:status": "powershell -File tools/scripts/db-status.ps1",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "test:backend": "npm --prefix backend test"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
